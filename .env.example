# URL chính thức của website (dùng cho canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://dichoonline.vn

# Đường dẫn file cơ sở dữ liệu SQLite (mặc định: ./data/dicho.db)
DATABASE_PATH=./data/dicho.db

# Tài khoản quản trị khởi tạo (chỉ dùng khi CHƯA có admin nào trong DB).
# Mật khẩu tối thiểu 12 ký tự. Sau lần chạy đầu tiên nên xoá biến này đi.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Mã xác minh Google Search Console (tuỳ chọn)
GOOGLE_SITE_VERIFICATION=

# Thông tin cửa hàng hiển thị và dùng cho dữ liệu có cấu trúc (schema.org)
NEXT_PUBLIC_STORE_PHONE=1900 1234
NEXT_PUBLIC_STORE_EMAIL=hotro@dichoonline.vn
NEXT_PUBLIC_STORE_ADDRESS=123 Nguyễn Văn Linh, Quận 7, TP. Hồ Chí Minh

# Chuỗi ngẫu nhiên để băm IP trước khi lưu
IP_SALT=
